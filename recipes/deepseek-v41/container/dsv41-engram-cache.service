# The Engram holder container: keeps ~189 GiB of checkpoint pages locked for
# every pair. dsv41-pd requires it; stopping this stops the pair first.
[Unit]
Description=DeepSeek-V4.1 Engram holder (container)
Requires=docker.service
After=docker.service

[Service]
WorkingDirectory=/home/ubuntu/sglang-private/recipes/deepseek-v41/container
ExecStart=/usr/bin/docker compose -f compose.yaml --env-file dsv41.env up --no-deps --exit-code-from engram-cache engram-cache
# Active only once every shard is locked.
ExecStartPost=/home/ubuntu/sglang-private/recipes/deepseek-v41/container/wait-healthy.sh dsv41-engram-cache-1
ExecStop=/usr/bin/docker compose -f compose.yaml --env-file dsv41.env stop engram-cache
# `docker compose up` exits 130 when systemd stops it; that is a clean stop.
SuccessExitStatus=130
Restart=on-failure
RestartSec=30
TimeoutStartSec=2400
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
