# Settings for compose.yaml (docker compose --env-file). Values run to the end
# of the line; no shell expansion.

DSV41_IMAGE=dsv41-pd:latest
DSV41_MODEL=/data/DeepSeek-V4.1-Flash
# Run output directories and kernel caches live under here.
DSV41_DATA=/data/dsv41-bringup

# One pair: prefill on the first two GPUs, decode on the last two.
GPUS=4,5,6,7
PORT=8040
BOOTSTRAP_PORT=8999
NCCL_PORT=29600
ROUTER_METRICS_PORT=29001

# Passed to tp2-pd.sh after --cpu-engram-staging --split-cuda-graphs. Run #12's
# verified B200 configuration (2026-10-16) plus the 2026-10-17 prefill changes:
# engram prefetch on prefill, and NCCL LL128 for prefill's
# all-reduce (bit-exact and fastest at 1.5K-8K-token messages on these GPUs);
# decode graphs at 10/12/14 so 9-15 requests do not pad to 16, and decode polls
# KV transfers every second step. Four tokenizer processes per worker: the
# router sends chat text, and one process tokenizing ~38K-token prompts capped
# the pair near 5.5 req/s (3.1M TPM/GPU vs 4.84M with pre-tokenized requests).
# Prefill's pool is 1.5M tokens: at 1M the prefix cache of >24 ~39K-token
# conversations thrashed (hit 0.95 -> 0.35 at c32); 1M costs only ~4.4 GB here.
# HiCache on prefill, host tier 4x the GPU pool (~6M tokens, ~56 GB host RAM),
# so cache-thrash tests past c24 reload KV from host instead of recomputing.
# The launcher defaults it to direct IO + write_back: under CC the kernel IO
# backend with write_through cost 48% of prefill GPU time (c24 3.95M vs 4.39M).
# Prefill admits 16 requests, ordered by HRRN (2026-10-18): requests still
# sending KV keep their slot, so a cap of 8 admitted only 3-4 per batch, and
# FCFS queued cached turns behind bursts of 38K-token misses. c32 TTFT p95 6.72 s
# FCFS -> 4.12 s HRRN at the same TPM; misses wait longer (p95 15 s).
# 2026-10-19 TTFT fixes (c24 sanity 0.81/2.56/5.48 s vs 1.14/2.71/6.22 s, 5.18M
# vs 4.46M TPM/GPU; one 120 s run, not a matched A/B): 12288-token chunks (cold
# 26K-token first turns take 3 chunks, not 4; 16384 left ~7 GB after graph
# capture and OOMed in the eager indexer), prefill hands a finished batch's KV
# to decode before launching the next, HRRN leans 1.5x toward short prefills,
# and both workers tokenize only the new suffix of a conversation's prompt.
# On B300 replace --gpu-models B200 and the B200 pool sizes. Key the kernel cache to the image.
DSV41_LAUNCH_ARGS=--gpu-models B200 --context-length 131072 --chunk-size 12288 --prefill-requests 16 --prefill-schedule-policy hrrn --decode-requests 64 --decode-graph-extra-bs 10,12,14 --decode-polling-interval 2 --tokenizer-workers 4 --prefill-swa-prefix-tails 256 --max-total-tokens 1572864 --prefill-hicache-ratio 4 --decode-max-total-tokens 4194304 --mem-fraction 0.92 --custom-all-reduce on --prefill-graph-max-seq-len 65536 --prefill-env SGLANG_OPT_DSV41_ENGRAM_STAGING_PREFETCH=1 --prefill-env SGLANG_DSV41_ENGRAM_GATHER_THREADS=8 --prefill-env NCCL_PROTO=LL128 --prefill-env SGLANG_ENABLE_DISAGG_PREFILL_EARLY_RESULT=1 --prefill-env SGLANG_HRRN_SIZE_EXPONENT=1.5 --prefill-env SGLANG_OPT_PREFIX_PROMPT_ENCODE=1 --decode-env SGLANG_OPT_DSV41_ENGRAM_STAGING_PREFETCH=1 --decode-env SGLANG_DSV41_ENGRAM_GATHER_THREADS=8 --decode-env SGLANG_OPT_PREFIX_PROMPT_ENCODE=1 --compact-host-memory --kernel-cache-dir /data/dsv41-bringup/container-cache/dsv41-pd-latest
# Appended to the flags above; set it in the environment for one-off runs, e.g.
# a runtime drop-in for dsv41-pd.
DSV41_EXTRA_ARGS=
