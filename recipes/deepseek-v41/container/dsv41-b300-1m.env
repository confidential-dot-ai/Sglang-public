# Settings for compose.yaml on one 8x B300 CC node at 1M context:
#   docker compose -f compose.yaml --env-file dsv41-b300-1m.env up --no-deps pd
# UNQUALIFIED: built from B200 measurements; no B300 boot yet.
# TP2 prefill + TP2 decode workers (5.51M TPM/GPU on 4x B200, c24). On the
# Deepseek-V41-release-ced branch the default is dsv41-b300-1m-ced.env (CED-split
# PP2, 5.05M on the same test); this file is the alternative there.
# Values run to the end of the line; no shell expansion.

DSV41_IMAGE=dsv41-pd:latest
DSV41_MODEL=/data/DeepSeek-V4.1-Flash
DSV41_DATA=/data/dsv41-bringup

# Two TP2/EP2 prefill workers (prefill0 GPUs 0-1, prefill1 GPUs 2-3) and two
# TP2/EP2 decode workers with DSpark (decode0 GPUs 4-5, decode1 GPUs 6-7).
# Router 8040; prefill 8041-8042 (bootstrap 8999-9000); decode 8043-8044. Both
# roles route by X-SMG-Routing-Key (manual), so a conversation keeps its prefill
# prefix cache and its decode radix cache on one worker each.
GPUS=0,1,2,3,4,5,6,7
PORT=8040
BOOTSTRAP_PORT=8999
NCCL_PORT=29600
ROUTER_METRICS_PORT=29001
# The bench profile's oracle-proxy targets one prefill/decode pair only.
PREFILL_PORT=8041
DECODE_PORT=8043
ORACLE_PROXY_PORT=8034

# dsv41.env's serving flags with these changes for B300 and 1M context:
# --memory-profile B300 sizes both pools from HBM (auto): ~51M tokens per
# prefill rank and ~55M per decode rank at 1M context, estimates until the first
# B300 boot (the HBM figure is nominal until preflight sees memory.total). HiCache
# is a 32 GiB host tier per prefill rank (128 GiB host RAM in all, on top of the
# ~189 GiB Engram holder). Decode keeps each conversation's KV (decode radix
# cache), so prefill ships only the uncached suffix. The prefill graph cap
# follows --context-length.
# Both roles wait up to 20 min for a KV handoff (default 5): a 1M request queued
# behind other cold 1M prefills can exceed 300 s before its transfer completes.
# Prefill graphs stay capped at 65536 (2026-10-20): with the cap following
# --context-length (131072) plus the eager-indexer memory changes, prefill hit a
# CUDA illegal memory access in graph replay under c24; either change alone ran
# clean (cap 65536: 5.51M TPM/GPU, TTFT 0.46/1.82/5.59 s). Root cause open.
DSV41_LAUNCH_ARGS=--gpu-models B300,GB300 --memory-profile B300 --num-prefill 2 --num-decode 2 --context-length 1048576 --chunk-size 12288 --prefill-requests 16 --prefill-schedule-policy hrrn --decode-requests 64 --decode-graph-extra-bs 10,12,14 --decode-polling-interval 2 --tokenizer-workers 4 --prefill-swa-prefix-tails 256 --max-total-tokens auto --prefill-hicache-size-gib 32 --prefill-transient-reserve-gib 16 --decode-max-total-tokens auto --mem-fraction 0.92 --custom-all-reduce on --prefill-env SGLANG_OPT_DSV41_ENGRAM_STAGING_PREFETCH=1 --prefill-env SGLANG_DSV41_ENGRAM_GATHER_THREADS=8 --prefill-env NCCL_PROTO=LL128 --prefill-env SGLANG_ENABLE_DISAGG_PREFILL_EARLY_RESULT=1 --prefill-env SGLANG_HRRN_SIZE_EXPONENT=1.5 --prefill-env SGLANG_OPT_PREFIX_PROMPT_ENCODE=1 --decode-env SGLANG_OPT_DSV41_ENGRAM_STAGING_PREFETCH=1 --decode-env SGLANG_DSV41_ENGRAM_GATHER_THREADS=8 --decode-env SGLANG_OPT_PREFIX_PROMPT_ENCODE=1 --decode-radix-cache --prefill-graph-max-seq-len 65536 --compact-host-memory --kernel-cache-dir /data/dsv41-bringup/container-cache/dsv41-pd-b300 --prefill-env SGLANG_DISAGGREGATION_WAITING_TIMEOUT=1200 --decode-env SGLANG_DISAGGREGATION_WAITING_TIMEOUT=1200
DSV41_EXTRA_ARGS=
