# Settings for compose.yaml on one 8x B300 CC node at 1M context:
#   docker compose -f compose.yaml --env-file dsv41-b300-1m.env up --no-deps pd
# UNQUALIFIED: built from B200 measurements (see ../b300-1m.md); no B300 boot yet.
# Values run to the end of the line; no shell expansion.

DSV41_IMAGE=dsv41-pd:latest
DSV41_MODEL=/data/DeepSeek-V4.1-Flash
DSV41_DATA=/data/dsv41-bringup

# Three TP2 prefill workers (GPUs 0-5) and one TP2 decode worker (GPUs 6-7). A
# cold 1M-token prompt takes ~50 s on one TP2 prefill (~20K new tokens/s), so
# prefill gets the GPUs; one decode holds ~52 1M-token contexts per rank.
# Router 8040; prefill 8041-8043 (bootstrap 8999-9001); decode 8044.
GPUS=0,1,2,3,4,5,6,7
PORT=8040
BOOTSTRAP_PORT=8999
NCCL_PORT=29600
ROUTER_METRICS_PORT=29001
# The bench profile's oracle-proxy targets one prefill/decode pair only.
PREFILL_PORT=8041
DECODE_PORT=8044
ORACLE_PROXY_PORT=8034

# dsv41.env's serving flags with these changes for B300 and 1M context:
# --memory-profile B300 sizes both pools from HBM (auto): ~51M prefill and ~55M
# decode tokens per rank, leaving ~10 GiB prefill / ~16 GiB decode free (the
# B300 HBM figure is nominal until preflight sees memory.total). HiCache is sized
# per rank (--hicache-size) rather than by ratio: 4x a 51M-token pool would need
# ~740 GiB of host RAM per prefill worker. 64 GiB x 2 ranks x 3 workers = 384 GiB
# host, on top of the ~189 GiB Engram holder; lower it if the host has less RAM.
# Preflight now counts these host pools. The router keeps each conversation
# (X-SMG-Routing-Key) on one prefill worker, so its prefix cache stays local.
DSV41_LAUNCH_ARGS=--gpu-models B300,GB300 --memory-profile B300 --num-prefill 3 --num-decode 1 --context-length 1048576 --chunk-size 12288 --prefill-requests 16 --prefill-schedule-policy hrrn --decode-requests 64 --decode-graph-extra-bs 10,12,14 --decode-polling-interval 2 --tokenizer-workers 4 --prefill-swa-prefix-tails 256 --max-total-tokens auto --prefill-hicache-size-gib 64 --decode-max-total-tokens auto --mem-fraction 0.92 --custom-all-reduce on --prefill-graph-max-seq-len 65536 --prefill-env SGLANG_OPT_DSV41_ENGRAM_STAGING_PREFETCH=1 --prefill-env SGLANG_DSV41_ENGRAM_GATHER_THREADS=8 --prefill-env NCCL_PROTO=LL128 --prefill-env SGLANG_ENABLE_DISAGG_PREFILL_EARLY_RESULT=1 --prefill-env SGLANG_HRRN_SIZE_EXPONENT=1.5 --prefill-env SGLANG_OPT_PREFIX_PROMPT_ENCODE=1 --decode-env SGLANG_OPT_DSV41_ENGRAM_STAGING_PREFETCH=1 --decode-env SGLANG_DSV41_ENGRAM_GATHER_THREADS=8 --decode-env SGLANG_OPT_PREFIX_PROMPT_ENCODE=1 --compact-host-memory --kernel-cache-dir /data/dsv41-bringup/container-cache/dsv41-pd-b300
DSV41_EXTRA_ARGS=
